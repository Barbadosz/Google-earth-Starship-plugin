{
  "Urls": "http://127.0.0.1:8080",
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "Paths": {
    "Root": "",
    "Data": "data",
    "Assets": "assets",
    "Database": "data/starship.db",
    "Logs": "logs"
  },
  "Simulation": {
    "DefaultSpeed": 10,
    "SampleIntervalSeconds": 0.5,
    "TickMilliseconds": 250,
    "MaxConsecutiveFailures": 3,
    "AutoStart": false,
    "AutoStartMissionCode": "",
    "AutoStartCountdownSeconds": 10
  },
  "NetworkLinks": {
    "PlannedRefreshSeconds": 60,
    "HistoryRefreshSeconds": 0.5,
    "LiveRefreshSeconds": 0.5,
    "MinRefreshPeriodSeconds": 0.25
  },
  "Live": {
    "StaleAfterSeconds": 15
  },
  "History": {
    "MaxPointsPerVehicle": 10000
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  }
}
